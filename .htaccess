# SOVMS - Apache configuration (dev). Production: move sensitive dirs outside webroot.

# Disable directory listing
Options -Indexes

# Default document
DirectoryIndex index.php

# Protect sensitive files/directories
<FilesMatch "^(config|includes|sql|logs|backups|tests|docs)">
    Require all denied
</FilesMatch>

# Protect dotfiles
<FilesMatch "^\.">
    Require all denied
</FilesMatch>

# Protect backup/sql/log file extensions anywhere
<FilesMatch "\.(sql|bak|log|ini|env|md)$">
    Require all denied
</FilesMatch>

# Security headers (also reinforced in PHP)
<IfModule mod_headers.c>
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
    Header always set X-XSS-Protection "1; mode=block"
</IfModule>

# Force UTF-8
AddDefaultCharset utf-8

# Rewrite for clean URLs (future use)
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /VOTING_SYSTEM/
    # Keep links generated for the XAMPP subfolder working when deployed at the domain root.
    RewriteRule ^VOTING_SYSTEM/(.*)$ /$1 [L]
    RewriteRule ^(config|includes|sql|logs|backups|tests|docs)(/|$) - [F,L]
</IfModule>
